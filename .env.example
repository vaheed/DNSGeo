# Copy this file to .env, then change every secret before production.

# Published ports. No host-IP bind is used, so Docker publishes on all host interfaces.
DNS_PORT=53
POSTGRES_PORT=5432
PDNS_API_PORT=8081
POWERADMIN_PORT=8080
# Optional. Keep empty for local HTTP. Set to a real DNS name and use docker-compose.https.yml for public HTTPS.
POWERADMIN_FQDN=
ACME_EMAIL=admin@vaheed.net

# PostgreSQL superuser and application passwords.
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres-superuser
PDNS_DB_PASSWORD=change-me-pdns-db
POWERADMIN_DB_PASSWORD=change-me-poweradmin-db
REPLICATION_PASSWORD=change-me-replication

# PowerDNS API and webserver.
PDNS_API_KEY=change-me-long-random-api-key
PDNS_WEBSERVER_PASSWORD=change-me-pdns-webserver-password
PDNS_WEBSERVER_ALLOW_FROM=0.0.0.0/0,::/0

# Poweradmin bootstrap. Use stable for production. Valid upstream lines are stable, 4.2.x, and 4.3.x.
POWERADMIN_TAG=stable
PA_ADMIN_USERNAME=admin
PA_ADMIN_PASSWORD=change-me-poweradmin-admin
PA_ADMIN_EMAIL=admin@vaheed.net
PA_ADMIN_FULLNAME=DNSAdministrator
PA_SESSION_KEY=change-me-64-char-random-session-key
PA_STYLE=dark
PA_TIMEZONE=Europe/Amsterdam

# Default authoritative identity and seeded SQL zone.
DNS_BASE_DOMAIN=vaheed.net
DNS_NS1=nsg-01.vaheed.net
DNS_NS2=nsg-02.vaheed.net
DNS_NS3=nsg-03.vaheed.net
DNS_HOSTMASTER=hostmaster.vaheed.net
DNS_DEFAULT_SERIAL=2026052601
SEED_BASE_ZONE=true
SEED_LUA_EXAMPLES=true

# Default Lua GeoDNS example targets. Replace them before using the seeded examples publicly.
LUA_GEO_DEFAULT_IPV4=203.0.113.10
LUA_GEO_EU_IPV4=203.0.113.40
LUA_GEO_NA_IPV4=203.0.113.50
LUA_GEO_AS_IPV4=203.0.113.30
LUA_GEO_HEALTH_PORT=443

# Replace these with the real public addresses of nsg-01, nsg-02, and nsg-03.
NS1_IPV4=203.0.113.11
NS2_IPV4=203.0.113.12
NS3_IPV4=203.0.113.13
NS1_IPV6=
NS2_IPV6=
NS3_IPV6=

# PostgreSQL primary replication and TLS.
PG_MAX_WAL_SENDERS=30
PG_MAX_REPLICATION_SLOTS=30
PG_WAL_KEEP_SIZE=4096MB
PG_TLS_DAYS=3650
PG_TLS_CA_CN=VirakCloudPostgreSQLCA
PG_TLS_SERVER_CN=postgres
PG_TLS_SAN=DNS:postgres,DNS:pdns-postgres-primary,DNS:nsg-01.vaheed.net,DNS:nsg-02.vaheed.net,DNS:nsg-03.vaheed.net,IP:127.0.0.1
PG_REPLICATION_CLIENT_CERT_AUTH=true
DB_INIT_TIMEOUT_SECONDS=300
PDNS_DB_WAIT_TIMEOUT_SECONDS=300
POWERADMIN_DB_WAIT_TIMEOUT_SECONDS=300

# PowerDNS PostgreSQL TLS connection. verify-ca works with the generated CA and does not require hostname verification.
PDNS_GPGSQL_EXTRA_CONNECTION_PARAMETERS=sslmode=verify-ca sslrootcert=/var/lib/postgresql/tls/ca.crt

# Lua GeoDNS. Records are PostgreSQL LUA records. The geoip backend is loaded only for Lua GeoIP functions.
PDNS_GEO_BOOTSTRAP_ZONE_FILE=/etc/powerdns/geo/lua-bootstrap.yml
PDNS_GEO_MMDB_FILE=/var/lib/powerdns/mmdb/GeoLite2-City.mmdb
PDNS_EDNS_SUBNET_PROCESSING=yes
PDNS_ENABLE_LUA_RECORDS=yes
PDNS_LUA_RECORDS_EXEC_LIMIT=1000
PDNS_LUA_HEALTH_CHECKS_INTERVAL=5
PDNS_LUA_HEALTH_CHECKS_EXPIRE_DELAY=3600
PDNS_CACHE_TTL=30
PDNS_QUERY_CACHE_TTL=30
PDNS_LOGLEVEL=5
PDNS_RESTART_ON_MMDB_CHANGE=yes
PDNS_MMDB_WATCH_INTERVAL_SECONDS=300

# Daily MMDB downloader. Default is DB-IP City Lite through jsDelivr CDN.
# It uses a direct HTTPS URL: no account, token, API key, captcha, or MaxMind/IP2Location workflow.
# Provider options:
#   dbip-jsdelivr  = DB-IP City Lite MMDB via CDN, monthly upstream update, no token. Recommended default.
#   dbip-official  = official DB-IP monthly URL, no token; tries current month, then previous month.
#   ip66           = IP66 MMDB, daily upstream update, no token, country/continent/ASN only.
#   generic        = use MMDB_DOWNLOAD_URL directly.
#   ip2location    = legacy token mode.
MMDB_PROVIDER=dbip-jsdelivr

# Optional IP2Location compatibility fields. Leave empty unless MMDB_PROVIDER=ip2location.
IP2LOCATION_DOWNLOAD_TOKEN=
IP2LOCATION_DATABASE_CODE=DB9LITEMMDB

# Optional generic override. If MMDB_DOWNLOAD_URL is set, it overrides MMDB_PROVIDER.
# Supported artifact types: .mmdb, .mmdb.gz, .tar.gz, .tgz, or .zip containing one MMDB file.
MMDB_DOWNLOAD_URL=
MMDB_DOWNLOAD_HEADER=
MMDB_DOWNLOAD_INTERVAL_SECONDS=86400
MMDB_DOWNLOAD_RETRIES=5
MMDB_EXPECTED_SHA256=
MMDB_TARGET_FILE=GeoLite2-City.mmdb
